# Include inside the existing HTTPS server {} for your domain.
# This endpoint proxies one public object only; it is not an open proxy.
location = @@PATH@@ {
    limit_except GET { deny all; }
    # Do not pass client query arguments, cookies, IP or credentials to COS.
    set $args "";
    proxy_pass https://horizon-link-content-1523285230.cos.ap-guangzhou.myqcloud.com/weekly/weekly.json;
    proxy_http_version 1.1;
    proxy_pass_request_headers off;
    proxy_pass_request_body off;
    proxy_set_header Host horizon-link-content-1523285230.cos.ap-guangzhou.myqcloud.com;
    proxy_set_header Connection "";
    proxy_set_header Content-Length "";
    proxy_set_header Cache-Control no-cache;
    proxy_ssl_server_name on;
    proxy_ssl_name horizon-link-content-1523285230.cos.ap-guangzhou.myqcloud.com;
    proxy_ssl_verify on;
    proxy_ssl_trusted_certificate @@CA_BUNDLE@@;
    proxy_ssl_verify_depth 5;
    proxy_connect_timeout 4s;
    proxy_send_timeout 4s;
    proxy_read_timeout 8s;
    proxy_cache off;
    expires off;
    proxy_intercept_errors off;
    proxy_hide_header Cache-Control;
    add_header Cache-Control no-cache always;
    # Access/error logs inherit the site's settings; review retention on deployment.
}
